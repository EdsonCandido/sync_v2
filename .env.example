# Local: docs/LOCAL.md | Produção: docs/PRODUCAO.md
#
# Local típico = só Postgres no Compose; web/server via npm run dev.
# Produção / docker:up = stack completa (web + server + postgres).

# Compose project (isolamento vs outros stacks no mesmo host)
COMPOSE_PROJECT_NAME=sync_v2

# Postgres
POSTGRES_PASSWORD=password

# URL pública da API (bake no build do web — rebuild se mudar)
# Docker full-stack local: http://localhost:13000 | Prod: https://api.sync.helioslabs.com.br
# (npm run dev no host usa apps/web/.env com http://localhost:3000)
VITE_SERVER_URL=http://localhost:13000

# Seed automático no start do container server (produção: true; local: false)
SEED_ON_START=false

# Portas no host (evita conflito com 3000/3001/5432 de outros serviços)
WEB_HOST_PORT=13001
SERVER_HOST_PORT=13000
POSTGRES_HOST_PORT=15432
