# Local / npm run dev — ver docs/LOCAL.md
# Produção (Docker + NPM) — ver docs/PRODUCAO.md
# Secret >= 32 caracteres
BETTER_AUTH_SECRET=change-me-to-a-long-random-secret-32chars
BETTER_AUTH_URL=http://localhost:3000
# Vite/React Router em npm run dev usa 5173 (não a porta Docker 3001)
# Vários origins: separar por vírgula (ex: https://a.com,https://b.com)
CORS_ORIGIN=http://localhost:5173
# Compose publica Postgres em 127.0.0.1:15432 (POSTGRES_HOST_PORT)
DATABASE_URL=postgresql://postgres:password@localhost:15432/sync_v2

# Bootstrap Helios Labs (obrigatório para db:seed / SEED_ON_START=true)
SEED_SUPER_NAME=Super Helios
SEED_SUPER_EMAIL=super@helioslabs.com.br
SEED_SUPER_PASSWORD=change-me-super-8plus

SEED_ADMIN_NAME=Admin Helios
SEED_ADMIN_EMAIL=admin@helioslabs.com.br
SEED_ADMIN_PASSWORD=change-me-admin-8plus

SEED_CLIENTE_NAME=Cliente Helios
SEED_CLIENTE_EMAIL=cliente@helioslabs.com.br
SEED_CLIENTE_PASSWORD=change-me-cliente-8plus

SEED_COMPANY_NAME=Helios Labs
SEED_COMPANY_DOCUMENT=00000000000191
SEED_COMPANY_EMAIL=contato@helioslabs.com.br

SEED_CLIENT_NAME=Helios Labs
SEED_CLIENT_DOCUMENT=00000000000

SEED_BANK_NAME=Banco do Brasil
SEED_BANK_AGENCIA=1234-5
SEED_BANK_CONTA=12345-6

SEED_SUPPLIER_NAME=Fornecedor Avulso

# Consulta pública ITR (escopo Helios). Fallback: SEED_COMPANY_DOCUMENT
ITR_PUBLIC_COMPANY_DOCUMENT=00000000000191
