{
	"name": "server",
	"type": "module",
	"main": "src/index.ts",
	"scripts": {
		"build": "tsdown",
		"check-types": "tsc -b",
		"compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
		"dev": "tsx watch src/index.ts",
		"start": "node dist/index.mjs",
		"db:seed": "sh ./run-cli.sh seed",
		"db:seed-financeiro-defaults": "sh ./run-cli.sh backfillFinanceiroDefaults"
	},
	"dependencies": {
		"@sync_v2/auth": "*",
		"@sync_v2/contracts": "*",
		"@sync_v2/db": "*",
		"@sync_v2/env": "*",
		"@sync_v2/types": "*",
		"@sync_v2/utils": "*",
		"better-auth": "1.6.23",
		"chart.js": "^4.5.1",
		"chartjs-node-canvas": "^5.0.0",
		"cors": "^2.8.6",
		"dotenv": "^17.4.2",
		"express": "^5.2.1",
		"express-rate-limit": "^8.6.2",
		"multer": "^2.2.0",
		"pdfkit": "^0.19.1",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@sync_v2/config": "*",
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.6",
		"@types/multer": "^2.2.0",
		"@types/node": "^22.13.14",
		"@types/pdfkit": "^0.17.6",
		"tsdown": "^0.22.3",
		"tsx": "^4.22.5",
		"typescript": "^6"
	}
}
